                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "categories", "{{categoryId}}"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Categoria Postman updated\",\n  \"description\": \"Categoria de ejemplo.\"\n}",
                  "options": {
                    "raw": { "language": "json" }
                  }
                },
                "description": "Esperado: 200. Actualiza los campos enviados; utiliza un categoryId existente."
              },
              "response": []
            },
            {
              "name": "Actualizar categoria parcialmente (PATCH, admin)",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
                "auth": {
