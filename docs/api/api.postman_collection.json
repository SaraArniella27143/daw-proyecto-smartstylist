{
  "info": { 
    "_postman_id": "6f77a50d-167e-42f3-a571-4e8d8df6f782",
    "name": "SmartStylist API",
    "description": "Coleccion para probar SmartStylist API: health check, registro, autenticacion JWT, cierre de sesion, administracion y borrado de usuarios, y CRUD de categorias, estilos y colores. Incluye casos de permisos, validacion, recursos inexistentes y conflictos. No utiliza scripts: tokens e identificadores se copian manualmente a las variables de coleccion. Las cuentas demo y sus contrasenas conocidas son solo para desarrollo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "adminDemoPassword", "value": "Admin1234!" },
    { "key": "userDemoPassword", "value": "User1234!" },
    { "key": "adminToken", "value": "" },
    { "key": "user1Token", "value": "" },
    { "key": "user2Token", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "styleId", "value": "" },
    { "key": "colorId", "value": "" },
    { "key": "registeredEmail", "value": "" },
    { "key": "userToDeleteId", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "description": "Credenciales demo locales: admin@cifpaviles.es / Admin1234!; user1@cifpaviles.es y user2@cifpaviles.es / User1234!. Copia manualmente access_token desde login a la variable indicada.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Endpoint público para confirmar que la API está disponible."
          },
          "response": []
        },
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Postman\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"PostmanPassword123!\",\n  \"password_confirmation\": \"PostmanPassword123!\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            },
            "description": "POST /api/register. Para repetir la prueba, cambia registeredEmail por una dirección todavía no registrada. Espera 201 y un usuario con rol user."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como administrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cifpaviles.es\",\n  \"password\": \"{{adminDemoPassword}}\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Cuenta demo disponible solo en entornos no-production. Copia access_token a adminToken."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como usuario 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@cifpaviles.es\",\n  \"password\": \"{{userDemoPassword}}\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Copia access_token a la variable user1Token."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como usuario 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2@cifpaviles.es\",\n  \"password\": \"{{userDemoPassword}}\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Copia access_token a la variable user2Token."
          },
          "response": []
        },
        {
          "name": "Cerrar sesión e invalidar token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{user1Token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            },
            "description": "Esperado: 204 sin cuerpo. Invalida el JWT de user1Token; después de ejecutarla, inicia sesión otra vez para seguir usando las peticiones protegidas."
          },
          "response": []
        },
        {
          "name": "Login con credenciales inválidas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-existe@example.test\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Prueba negativa: debe responder 401 en Problem Details."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Administración de usuarios",
      "description": "Crea una cuenta estándar desde Registrar usuario y copia su id a userToDeleteId. La cuenta de administrador se provisiona fuera del registro público.",
      "item": [
        {
          "name": "Eliminar usuario (debe dar 403 a user)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{user1Token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userToDeleteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userToDeleteId}}"]
            },
            "description": "Prueba negativa: un usuario estándar no puede borrar cuentas. Esperado: 403 Problem Details."
          },
          "response": []
        },
        {
          "name": "Eliminar usuario (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userToDeleteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userToDeleteId}}"]
            },
            "description": "Esperado: 204 sin cuerpo. Elimina la cuenta y sus datos asociados en cascada. No se permite eliminar al último administrador."
          },
          "response": []
        },
        {
          "name": "Eliminar usuario inexistente (admin, 404)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/999999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "999999999"]
            },
            "description": "Prueba negativa: esperado 404 en Problem Details."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catálogos",
      "description": "CRUD de categorias, estilos y colores. Todos los endpoints requieren autenticacion; los usuarios pueden leer y los administradores crear, actualizar y eliminar. Incluye casos negativos de permisos, validacion, recursos inexistentes y conflictos por prendas asociadas.",
      "item": [
        {
          "name": "Categorias",
          "description": "CRUD de categorias. Las lecturas requieren autenticacion; crear, actualizar y eliminar requieren token admin.",
