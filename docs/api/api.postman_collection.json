                  "path": ["api", "categories", "{{categoryId}}"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"description\": \"Updated description for Categoria Postman.\"\n}",
                  "options": {
                    "raw": { "language": "json" }
                  }
                },
                "description": "Esperado: 200. Actualiza solo el campo enviado."
              },
              "response": []
            },
            {
              "name": "Eliminar categoria (admin)",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
