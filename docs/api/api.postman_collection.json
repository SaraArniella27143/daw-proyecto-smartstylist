                    "raw": { "language": "json" }
                  }
                },
                "description": "Esperado: 201. Copia data.id de la respuesta en categoryId. Usa un nombre unico."
              },
              "response": []
            },
            {
              "name": "Crear categoria (debe dar 403 a user)",
